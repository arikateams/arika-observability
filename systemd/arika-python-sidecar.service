[Unit]
Description=Arika FastAPI metrics and RAG sidecar
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=arika-monitoring
Group=arika-monitoring
WorkingDirectory=/opt/arika/observability/sidecar
EnvironmentFile=/etc/arika/observability.env
ExecStart=/opt/arika/observability/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
